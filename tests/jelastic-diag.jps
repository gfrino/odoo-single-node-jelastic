type: install
id: odoo-single-node-diag
name: Odoo Single Node - platform check
description:
  short: Creates one Ubuntu VPS node like the real manifest (optionally with a public IP, never with volumes), tries adding a volume through the API and reports the result. Delete the environment afterwards.

globals:
  volumeApi: not reported (onAfterReturn not supported?)

settings:
  fields:
    - name: extip
      caption: Public IPv4
      type: toggle
      value: true

nodes:
  - nodeType: ubuntu-vps
    tag: "24.04"
    nodeGroup: cp
    fixedCloudlets: 4
    cloudlets: 32
    extip: ${settings.extip}

onInstall:
  - cmd[cp]: |-
      . /etc/os-release; echo "OS: $PRETTY_NAME"
      echo "IPs: $(ip -4 -o addr show scope global | awk '{print $4}' | tr '\n' ' ')"
      echo "Route: $(ip route show default | head -1)"
      if apt-get update -q > /tmp/apt.log 2>&1; then echo "apt: ok"; else echo "apt: FAILED"; tail -3 /tmp/apt.log; fi
      echo "Outbound IP: $(curl -s --max-time 10 https://api.ipify.org || echo none)"
    user: root
  - setGlobals:
      net: ${response.out}

  # Can volumes be added after the node exists? (API route, one test path)
  - script: |
      var tries = [], ok = false;
      function attempt(label, fn) {
        if (ok) return;
        try {
          var r = fn();
          tries.push(label + ": " + r.result + (r.error ? " " + r.error : ""));
          if (r.result === 0) ok = true;
        } catch (e) {
          tries.push(label + ": exception " + String(e));
        }
      }
      attempt("AddContainerVolumeByGroup", function () {
        return api.environment.control.AddContainerVolumeByGroup({envName: "${env.name}", nodeGroup: "cp", path: "/var/backups/odoo"});
      });
      attempt("AddContainerVolumes", function () {
        return api.environment.control.AddContainerVolumes({envName: "${env.name}", nodeGroup: "cp", volumes: ["/var/backups/odoo"]});
      });
      return {result: 0, onAfterReturn: {setGlobals: {volumeApi: tries.join(" | ")}}};
  - cmd[cp]: 'findmnt -rn -o TARGET,SOURCE /var/backups/odoo || echo "/var/backups/odoo: not a mount"'
    user: root
  - setGlobals:
      mount: ${response.out}

success: |
  ```
  ${globals.net}

  Volume API: ${globals.volumeApi}
  ${globals.mount}
  ```

type: install
id: odoo-single-node-diag
name: Odoo Single Node - platform check
description:
  short: Creates one plain Ubuntu VPS node and reports what the platform provides. Delete the environment afterwards.

onBeforeInit: |
  // Only one level of simple values: the template is a Java object with cycles.
  function show(v) {
    if (v === null || v === undefined) return String(v);
    var type = typeof v;
    if (type == "string" || type == "number" || type == "boolean") return String(v);
    if (v.length !== undefined && typeof v != "function") {
      var items = [];
      for (var j = 0; j < v.length && j < 30; j++) {
        var x = v[j];
        items.push(x !== null && typeof x == "object" ? String(x.name || x.tag || x.version || "{obj}") : String(x));
      }
      return "[" + items.join(", ") + "]";
    }
    return "{obj}";
  }
  var settings = {fields: []};
  var resp = api.environment.control.GetTemplates();
  var info = "GetTemplates failed: " + resp.result;
  if (resp.result === 0) {
    info = "ubuntu-vps not found";
    for (var i = 0, n = resp.array.length; i < n; i++) {
      var t = resp.array[i];
      if (String(t.nodeType) == "ubuntu-vps") {
        var lines = [];
        for (var k in t) {
          try { lines.push(k + " = " + show(t[k])); } catch (e) { lines.push(k + " = <error>"); }
        }
        info = lines.join("<br>");
        break;
      }
    }
  }
  settings.fields.push({type: "displayfield", name: "info", hideLabel: true,
    markup: "<b>Template ubuntu-vps</b><br>" + String(info).substring(0, 6000)});
  return {result: 0, settings: settings};

nodes:
  - nodeType: ubuntu-vps
    nodeGroup: cp
    cloudlets: 8

onInstall:
  - cmd[cp]: |-
      . /etc/os-release; echo "OS: $PRETTY_NAME"
      echo "Kernel: $(uname -r)"
      echo "RAM: $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo) MB, CPU: $(nproc)"
      echo "systemd: $(ps -p 1 -o comm=)"
      echo "IPv6: $([ -s /proc/net/if_inet6 ] && echo yes || echo no)"
      echo "Disk: $(df -h --output=size,avail / | tail -1)"
      if apt-get update -q > /tmp/apt.log 2>&1; then echo "apt: ok"; else echo "apt: FAILED"; tail -5 /tmp/apt.log; fi
      echo "Mounts: $(findmnt -rn -o TARGET | grep -vE '^/(proc|sys|dev|run)' | tr '\n' ' ')"
    user: root
  - setGlobals:
      out: ${response.out}

success: |
  ```
  ${globals.out}
  ```

type: update
id: odoo-manager
name: Odoo Manager
logo: https://raw.githubusercontent.com/jelastic-jps/odoo/master/images/odoo-logo.png
homepage: https://github.com/gfrino/odoo-single-node-jelastic
# Installed by manifest.jps on the Odoo node. It can also be (re)installed on an
# existing environment: Import → URL with this file, then choose the environment.
# nodeGroup: cp lists every environment with a cp layer (classic Odoo ones too);
# a nodeType filter hid the single-node environments on Infomaniak. onInstall
# refuses nodes that were not set up by manifest.jps.
targetNodes:
  nodeGroup: cp

onInstall:
  - cmd[cp]: |-
      if [ ! -x /opt/odoo/jps/status.sh ]; then
        echo "This node was not installed with odoo-single-node-jelastic (no /opt/odoo/jps): Odoo Manager only works on those."
        exit 1
      fi
      echo ok
    user: root
description:
  short: Domains and SSL, backups, Odoo updates and PostgreSQL upgrades.

settings:
  addDomain:
    fields:
      - name: domains
        caption: Domains
        type: string
        required: true
        placeholder: erp.example.com, www.example.com
        tooltip: Comma-separated. Each DNS A record must already point to this node's public IP.
  removeDomain:
    fields:
      - name: domains
        caption: Domains
        type: string
        required: true
  # Filled when the form opens: builds available on nightly.odoo.com for the installed
  # major version (scripts/list-builds.sh on the node), newest preselected.
  updateOdoo:
    fields: []
    onBeforeInit: |
      var envName = "${env.name}", nodeId = 0, data = null, error = "";
      try {
        var info = api.env.control.GetEnvInfo(envName, session);
        var nodes = (info && info.nodes) || [];
        for (var i = 0; i < nodes.length; i++) {
          if (String(nodes[i].nodeGroup) == "cp") { nodeId = nodes[i].id; break; }
        }
        if (!nodeId) {
          error = "Odoo node not found";
        } else {
          var r = api.env.control.ExecCmdById(envName, session, nodeId,
            toJSON([{command: "bash /opt/odoo/jps/list-builds.sh", params: ""}]), false, "root");
          if (r.result === 0) data = JSON.parse(String(r.responses[0].out));
          else error = r.error || ("result " + r.result);
        }
      } catch (e) {
        error = String(e);
      }
      if (data && data.builds && data.builds.length) {
        var values = [];
        for (var j = 0; j < data.builds.length; j++) {
          var b = String(data.builds[j]);
          values.push({value: b, caption: data.series + " of " + b.substr(6, 2) + "/" + b.substr(4, 2) + "/" + b.substr(0, 4) +
            (b == String(data.installed) ? " (installed)" : "")});
        }
        settings.fields.push({name: "build", caption: "Build", type: "list", required: true,
          values: values, value: values[0].value, default: values[0].value});
      } else {
        settings.fields.push(
          {type: "displayfield", name: "buildsError", hideLabel: true,
           markup: "Could not read the available builds (" + error + "). Run ☰ → Update scripts and reopen, or type a build date."},
          {name: "build", caption: "Build (YYYYMMDD or latest)", type: "string", required: true, value: "latest", default: "latest"});
      }
      settings.fields.push({name: "updateModules", caption: "Update all modules (-u all)", type: "toggle",
        value: false, default: false, tooltip: "Only needed when the release notes say a fix changes data or views."});
      return settings;
  # Filled when the form opens: installed PostgreSQL major and the newer ones in PGDG
  # (scripts/list-pg-versions.sh on the node).
  upgradePostgres:
    fields: []
    onBeforeInit: |
      var envName = "${env.name}", nodeId = 0, data = null, error = "";
      try {
        var info = api.env.control.GetEnvInfo(envName, session);
        var nodes = (info && info.nodes) || [];
        for (var i = 0; i < nodes.length; i++) {
          if (String(nodes[i].nodeGroup) == "cp") { nodeId = nodes[i].id; break; }
        }
        if (!nodeId) {
          error = "Odoo node not found";
        } else {
          var r = api.env.control.ExecCmdById(envName, session, nodeId,
            toJSON([{command: "bash /opt/odoo/jps/list-pg-versions.sh", params: ""}]), false, "root");
          if (r.result === 0) data = JSON.parse(String(r.responses[0].out));
          else error = r.error || ("result " + r.result);
        }
      } catch (e) {
        error = String(e);
      }
      if (data && data.available && data.available.length) {
        var values = [];
        for (var j = 0; j < data.available.length; j++) {
          var v = String(data.available[j]);
          values.push({value: v, caption: "PostgreSQL " + v});
        }
        settings.fields.push(
          {type: "displayfield", name: "pgInstalled", hideLabel: true,
           markup: "Installed: PostgreSQL " + data.installed + ". A backup is taken first; Odoo is stopped during the upgrade."},
          {name: "pgTarget", caption: "Upgrade to", type: "list", required: true,
           values: values, value: values[values.length - 1].value, default: values[values.length - 1].value},
          {name: "dropOld", caption: "Remove the old cluster after a successful upgrade", type: "toggle",
           value: false, default: false,
           tooltip: "Off: the old version stays on disk, stopped, so you can go back. Remove it later from this form."});
      } else if (data) {
        settings.fields.push(
          {type: "displayfield", name: "pgUpToDate", hideLabel: true,
           markup: "Already on the newest version available: PostgreSQL " + data.installed + ". Nothing to upgrade."},
          {name: "dropOld", caption: "Remove old clusters left by previous upgrades", type: "toggle",
           value: false, default: false});
      } else {
        settings.fields.push(
          {type: "displayfield", name: "pgError", hideLabel: true,
           markup: "Could not read the available versions (" + error + "). Run ☰ → Update scripts and reopen, or type the version."},
          {name: "pgTarget", caption: "Target version", type: "string", placeholder: "newest available"},
          {name: "dropOld", caption: "Remove the old cluster after a successful upgrade", type: "toggle",
           value: false, default: false});
      }
      return settings;
  # Filled when the form opens: every running environment of the account with a backup
  # node (nodeGroup "bk", from backup-storage.jps) and the repositories on it.
  connectBackup:
    fields: []
    onBeforeInit: |
      var me = "${env.name}", values = [], notes = [];
      function nodeIn(nodes, group) {
        for (var i = 0; i < nodes.length; i++) if (String(nodes[i].nodeGroup) == group) return nodes[i].id;
        return 0;
      }
      try {
        var envs = api.env.control.GetEnvs();
        var infos = (envs && envs.infos) || [];
        for (var i = 0; i < infos.length; i++) {
          var env = infos[i].env || {}, name = String(env.envName), bk = nodeIn(infos[i].nodes || [], "bk");
          if (!bk) continue;
          if (env.status != 1) { notes.push(name + " is not running"); continue; }
          var r = api.env.control.ExecCmdById(name, session, bk,
            toJSON([{command: "bash /opt/odoo-backup/list-repos.sh", params: ""}]), false, "root");
          if (r.result !== 0) { notes.push(name + ": " + (r.error || r.result)); continue; }
          var repos = JSON.parse(String(r.responses[0].out)), mine = null;
          for (var j = 0; j < repos.length; j++) if (String(repos[j].repo) == me) mine = repos[j];
          for (var k = 0; k < repos.length; k++) {
            var o = repos[k];
            if (String(o.repo) == me) continue;
            values.push({value: name + "/" + o.repo, caption: o.repo + " (" + o.snapshots + " backups, last " +
              (o.last || "-") + ") on " + name});
          }
        }
      } catch (e) {
        notes.push(String(e));
      }
      if (values.length) {
        // No preselected value: with one, Jelastic kept the submit button disabled.
        settings.fields.push({name: "backupTarget", caption: "Backups of", type: "list", required: true,
          values: values});
        settings.fields.push({type: "displayfield", name: "connectNote", hideLabel: true,
          markup: "Only to recover a lost environment: this environment takes over that backup space " +
            "(the lost one can no longer write to it). Then use Restore from backup environment." +
            (notes.length ? "<br>Not listed: " + notes.join("; ") : "")});
      } else {
        settings.fields.push({type: "displayfield", name: "noBackupEnv", hideLabel: true,
          markup: "No backups of other environments found. To create a backup environment: Import → URL " +
            "https://raw.githubusercontent.com/gfrino/odoo-single-node-jelastic/main/backup-storage.jps (same region)." +
            (notes.length ? "<br>" + notes.join("; ") : "")});
      }
      return settings;

  # Filled when the form opens: the snapshots in the connected backup environment.
  remoteRestore:
    fields: []
    onBeforeInit: |
      var me = "${env.name}", data = null, error = "";
      try {
        var info = api.env.control.GetEnvInfo(me, session), nodes = (info && info.nodes) || [], id = 0;
        for (var i = 0; i < nodes.length; i++) if (String(nodes[i].nodeGroup) == "cp") { id = nodes[i].id; break; }
        var r = api.env.control.ExecCmdById(me, session, id,
          toJSON([{command: "bash /opt/odoo/jps/remote-backup.sh snapshots --json", params: ""}]), false, "root");
        if (r.result === 0) data = JSON.parse(String(r.responses[0].out));
        else error = r.error || ("result " + r.result);
      } catch (e) {
        error = String(e);
      }
      if (data && data.length) {
        var values = [];
        for (var j = 0; j < data.length; j++) {
          var t = String(data[j].time);
          values.push({value: String(data[j].id), caption: t.substr(8, 2) + "/" + t.substr(5, 2) + "/" + t.substr(0, 4) +
            " " + t.substr(11, 5) + " · " + data[j].id + " · " + data[j].host});
        }
        settings.fields.push(
          {name: "snapshot", caption: "Backup", type: "list", required: true, values: values},
          {type: "displayfield", name: "remoteRestoreNote", hideLabel: true,
           markup: "A local backup of the current state is taken first; the current database is kept aside until the restore has succeeded."});
      } else if (data) {
        settings.fields.push({type: "displayfield", name: "noSnapshots", hideLabel: true,
          markup: "No backups on the backup environment yet."});
      } else {
        settings.fields.push({type: "displayfield", name: "remoteError", hideLabel: true,
          markup: "Could not read the backups of the backup environment (" + error +
            "). Connect one first (☰ → Connect backup environment), or run ☰ → Update scripts."});
      }
      return settings;

  # Filled when the form opens: backups in /var/backups/odoo, newest first
  # (scripts/list-backups.sh on the node).
  restore:
    fields: []
    onBeforeInit: |
      function mb(bytes) { return (bytes / 1048576).toFixed(1) + " MB"; }
      var envName = "${env.name}", nodeId = 0, data = null, error = "";
      try {
        var info = api.env.control.GetEnvInfo(envName, session);
        var nodes = (info && info.nodes) || [];
        for (var i = 0; i < nodes.length; i++) {
          if (String(nodes[i].nodeGroup) == "cp") { nodeId = nodes[i].id; break; }
        }
        if (!nodeId) {
          error = "Odoo node not found";
        } else {
          var r = api.env.control.ExecCmdById(envName, session, nodeId,
            toJSON([{command: "bash /opt/odoo/jps/list-backups.sh", params: ""}]), false, "root");
          if (r.result === 0) data = JSON.parse(String(r.responses[0].out));
          else error = r.error || ("result " + r.result);
        }
      } catch (e) {
        error = String(e);
      }
      if (data && data.length) {
        var values = [];
        for (var j = 0; j < data.length; j++) {
          var b = data[j], d = String(b.date);
          values.push({value: String(b.file),
            caption: d.substr(8, 2) + "/" + d.substr(5, 2) + "/" + d.substr(0, 4) + " " + d.substr(11, 5) +
              " · " + b.tag + " · DB " + mb(b.db_bytes) + (b.files_bytes ? " + files " + mb(b.files_bytes) : "")});
        }
        settings.fields.push(
          {name: "dump", caption: "Backup", type: "list", required: true, values: values},
          {type: "displayfield", name: "restoreNote", hideLabel: true,
           markup: "The current database is renamed, not deleted, until the restore has succeeded."});
      } else if (data) {
        settings.fields.push({type: "displayfield", name: "noBackups", hideLabel: true,
          markup: "No backups in /var/backups/odoo yet. Use Backup now first."});
      } else {
        settings.fields.push(
          {type: "displayfield", name: "backupsError", hideLabel: true,
           markup: "Could not read the backups (" + error + "). Run ☰ → Update scripts and reopen, or type the path."},
          {name: "dump", caption: "Backup file", type: "string", required: true,
           placeholder: "/var/backups/odoo/odoo-YYYYmmdd-HHMMSS-tag.dump"});
      }
      return settings;

# Only three buttons fit on the tile; the rest is in its ☰ menu.
buttons:
  - caption: Status
    action: status
  - caption: Update Odoo
    action: updateOdoo
    settings: updateOdoo
    title: Update Odoo (same major version)
    submitButtonText: Update
  - caption: Backup now
    action: backup

menu:
  - caption: Add domain
    action: addDomain
    settings: addDomain
    title: Add domains with Let's Encrypt
    submitButtonText: Add
  - caption: Remove domain
    action: removeDomain
    settings: removeDomain
    submitButtonText: Remove
  - caption: Renew SSL now
    action: renewSsl
    confirmText: Force a Let's Encrypt renewal now? (It also renews automatically.)
  - caption: List backups
    action: listBackups
  - caption: Restore backup
    action: restore
    settings: restore
    confirmText: The current database is replaced by the backup. Continue?
    submitButtonText: Restore
  - caption: Connect backup environment
    action: connectBackup
    confirmText: Copy this environment's backups every night to the backup environment of this account (encrypted)?
  - caption: Recover backups of another environment
    action: connectBackup
    settings: connectBackup
    title: Take over the backups of a lost environment
    submitButtonText: Take over
  - caption: Back up to backup environment now
    action: remoteBackup
  - caption: Restore from backup environment
    action: remoteRestore
    settings: remoteRestore
    confirmText: The current database is replaced by the backup. Continue?
    submitButtonText: Restore
  - caption: Upgrade PostgreSQL
    action: upgradePostgres
    settings: upgradePostgres
    title: Upgrade PostgreSQL major version
    submitButtonText: Upgrade
  - caption: Update scripts
    action: updateScripts
    confirmText: Download the latest management scripts from GitHub?

actions:
  status:
    - cmd[cp]: bash /opt/odoo/jps/status.sh
      user: root
    - return:
        type: info
        message: "```\n${response.out}\n```"

  addDomain:
    - cmd[cp]: bash /opt/odoo/jps/ssl.sh add '${settings.domains}'
      user: root
    - return:
        type: success
        message: "Certificate issued. Status:\n```\n${response.out}\n```"

  removeDomain:
    - cmd[cp]: bash /opt/odoo/jps/ssl.sh remove '${settings.domains}' && bash /opt/odoo/jps/ssl.sh status
      user: root
    - return:
        type: success
        message: "```\n${response.out}\n```"

  renewSsl:
    - cmd[cp]: bash /opt/odoo/jps/ssl.sh renew && bash /opt/odoo/jps/ssl.sh status
      user: root
    - return:
        type: success
        message: "```\n${response.out}\n```"

  backup:
    - cmd[cp]: bash /opt/odoo/jps/backup.sh --tag manual 2>/dev/null
      user: root
    - return:
        type: success
        message: "Backup created: ${response.out}"

  listBackups:
    - cmd[cp]: ls -lh /var/backups/odoo/ | grep -v '^total'; df -h /var/backups/odoo | tail -1
      user: root
    - return:
        type: info
        message: "```\n${response.out}\n```"

  restore:
    - cmd[cp]: bash /opt/odoo/jps/restore.sh '${settings.dump}'
      user: root
    - return:
        type: success
        message: Backup restored.

  updateOdoo:
    - if (${settings.updateModules:false}):
        cmd[cp]: bash /opt/odoo/jps/update-odoo.sh --build '${settings.build}' --update-modules
        user: root
    - else:
        cmd[cp]: bash /opt/odoo/jps/update-odoo.sh --build '${settings.build}'
        user: root
    - return:
        type: success
        message: "```\n${response.out}\n```"

  upgradePostgres:
    - cmd[cp]: |-
        args=""
        [ -n '${settings.pgTarget:}' ] && args="--to ${settings.pgTarget:}"
        [ '${settings.dropOld:false}' = true ] && args="$args --drop-old"
        bash /opt/odoo/jps/upgrade-postgres.sh $args
      user: root
    - return:
        type: success
        message: "```\n${response.out}\n```"

  # Key on this node -> account on the backup node -> connect this node to it.
  connectBackup:
    - script: |
        var me = "${env.name}", sel = String("${settings.backupTarget:}").split("/"), bkEnv = sel[0], repo = sel[1];
        if (!bkEnv || !repo) {
          // Plain "Connect": the first running backup environment of the account, this env's own space.
          var envs = api.env.control.GetEnvs(), infos = (envs && envs.infos) || [];
          for (var i = 0; i < infos.length && !bkEnv; i++) {
            var nodes = infos[i].nodes || [];
            for (var j = 0; j < nodes.length; j++) {
              if (String(nodes[j].nodeGroup) == "bk" && (infos[i].env || {}).status == 1) { bkEnv = String(infos[i].env.envName); break; }
            }
          }
          if (!bkEnv) return {result: 99, error: "No running backup environment in this account. Create one first: Import → URL https://raw.githubusercontent.com/gfrino/odoo-single-node-jelastic/main/backup-storage.jps (same region)."};
          repo = me;
        }
        function nodeOf(envName, group) {
          var info = api.env.control.GetEnvInfo(envName, session), nodes = (info && info.nodes) || [];
          for (var i = 0; i < nodes.length; i++) if (String(nodes[i].nodeGroup) == group) return nodes[i].id;
          throw "no " + group + " node in " + envName;
        }
        function run(envName, nodeId, command) {
          var r = api.env.control.ExecCmdById(envName, session, nodeId, toJSON([{command: command, params: ""}]), false, "root");
          if (r.result !== 0) throw envName + ": " + (r.error || ("result " + r.result));
          return String(r.responses[0].out).replace(/\s+$/, "");
        }
        try {
          if (!/^[a-z0-9][a-z0-9-]*$/.test(bkEnv) || !/^[a-z0-9][a-z0-9-]*$/.test(repo)) throw "invalid selection";
          var odoo = nodeOf(me, "cp"), bk = nodeOf(bkEnv, "bk");
          var pub = run(me, odoo, "bash /opt/odoo/jps/remote-backup.sh keygen").split("\n").pop();
          var reg = JSON.parse(run(bkEnv, bk, "bash /opt/odoo-backup/add-client.sh '" + repo + "' '" + pub + "'").split("\n").pop());
          var out = run(me, odoo, "bash /opt/odoo/jps/remote-backup.sh connect --host " + reg.host + " --user " + reg.user +
            " --repo " + repo + " --env " + bkEnv + " --host-keys '" + reg.host_keys.join("|") + "' 2>&1 && " +
            "bash /opt/odoo/jps/remote-backup.sh run 2>&1 | tail -1");
          return {result: 0, onAfterReturn: {setGlobals: {connectOut: out}}};
        } catch (e) {
          return {result: 99, error: "Connect backup environment: " + e};
        }
    - return:
        type: success
        message: "```\n${globals.connectOut}\n```\nKeep the encryption password somewhere safe as well."

  remoteBackup:
    - cmd[cp]: bash /opt/odoo/jps/remote-backup.sh run 2>&1 | tail -1
      user: root
    - return:
        type: success
        message: ${response.out}

  remoteRestore:
    - cmd[cp]: bash /opt/odoo/jps/remote-backup.sh restore '${settings.snapshot}' 2>&1 | tail -3
      user: root
    - return:
        type: success
        message: "```\n${response.out}\n```"

  updateScripts:
    - cmd[cp]: |-
        set -e
        tmp=$(mktemp -d)
        curl -fsSL https://codeload.github.com/gfrino/odoo-single-node-jelastic/tar.gz/main | tar -xz -C "$tmp" --strip-components=1
        cp -a "$tmp"/scripts/. /opt/odoo/jps/
        chmod 755 /opt/odoo/jps/*.sh
        rm -rf "$tmp"
        bash /opt/odoo/jps/post-update.sh > /dev/null 2>&1 || true
        echo "Scripts updated from gfrino/odoo-single-node-jelastic@main and applied"
      user: root
    - return:
        type: success
        message: ${response.out}
